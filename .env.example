# ── Supabase ── (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...) эсвэл хуучин "anon public" key
NEXT_PUBLIC_SUPABASE_KEY=

# ── Gemini ── (https://aistudio.google.com → Get API key)
GEMINI_API_KEY=
# Free tier дээр ажилладаг загвар. Хэрэв алдаа гарвал AI Studio-оос боломжит загварын нэрийг шалгаарай.
GEMINI_MODEL=gemini-2.5-flash

# ── Desmos ── (заавал биш; хоосон бол туршилтын demo key ашиглана)
# Бодит ашиглалтад https://www.desmos.com/api дээрээс өөрийн key авна.
NEXT_PUBLIC_DESMOS_API_KEY=
